@startuml VoidRP-Auth-Launch
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #6E40C9
skinparam sequenceLifeLineBorderColor #8957E5
skinparam participantBorderColor #8957E5
skinparam participantBackgroundColor #F6F8FA
!ifdef DARK
skinparam backgroundColor #0D1117
skinparam defaultFontColor #E6EDF3
skinparam ArrowColor #A78BFA
skinparam ArrowFontColor #C9D1D9
skinparam componentBackgroundColor #161B22
skinparam componentBorderColor #A78BFA
skinparam componentFontColor #E6EDF3
skinparam databaseBackgroundColor #1F1640
skinparam databaseBorderColor #A78BFA
skinparam nodeBorderColor #8B949E
skinparam nodeFontColor #E6EDF3
skinparam nodeBackgroundColor #161B22
skinparam packageBorderColor #8B949E
skinparam packageFontColor #E6EDF3
skinparam cloudBorderColor #8B949E
skinparam cloudFontColor #E6EDF3
skinparam folderBackgroundColor #161B22
skinparam folderBorderColor #8B949E
skinparam folderFontColor #E6EDF3
skinparam actorBorderColor #E6EDF3
skinparam actorBackgroundColor #0D1117
skinparam actorFontColor #E6EDF3
skinparam titleFontColor #E6EDF3
skinparam sequenceLifeLineBorderColor #A78BFA
skinparam participantBackgroundColor #161B22
skinparam participantBorderColor #A78BFA
skinparam participantFontColor #E6EDF3
skinparam sequenceGroupBackgroundColor #161B22
skinparam sequenceGroupBodyBackgroundColor #0D1117
skinparam sequenceGroupBorderColor #8B949E
skinparam sequenceGroupFontColor #E6EDF3
skinparam sequenceGroupHeaderFontColor #E6EDF3
skinparam sequenceDividerBackgroundColor #161B22
skinparam sequenceDividerBorderColor #8B949E
skinparam sequenceDividerFontColor #E6EDF3
skinparam noteBackgroundColor #1F1640
skinparam noteBorderColor #A78BFA
skinparam noteFontColor #E6EDF3
!endif
title <b>VoidRP — Логин, синхронизация и вход на сервер</b>

actor Игрок as U
participant "Лаунчер\n(CoreHost)" as L
participant "Backend\nFastAPI" as B
participant "CDN\npack/manifests" as C
participant "Игровой\nсервер" as S

== Авторизация ==
U -> L : логин / пароль
L -> B : POST /auth/login
B --> L : JWT access + refresh
note right of L : refresh хранится\nи ротируется

== Выбор сервера и синхронизация пака ==
U -> L : выбрать сервер (slug)
L -> B : GET /servers/{slug}
B --> L : host, port, manifest_url,\nprofile (NeoForge), features
L -> C : GET manifest.json
C --> L : список файлов (path, size, SHA-256, flags)
loop до 8 файлов параллельно (HTTP/2)
  L -> L : NeedsDownload? (hash-cache / size / SHA-256)
  L -> C : GET файл (если нет / изменился / managed)
  C --> L : байты → проверка SHA-256
end
note right of L : alwaysOverwrite — форс,\nmanaged — синк по хешу,\nconfig/ игрока — не трогаем

== Play-ticket и запуск ==
U -> L : «Играть»
L -> B : POST /play-tickets (JWT)
B --> L : одноразовый ticket (TTL)
L -> S : запуск Minecraft → коннект (ticket)
S -> B : verify ticket\n(X-Game-Auth-Secret)
B --> S : профиль игрока (server_id)
S --> U : вход в мир

== Плагинный сервер (Origins) ==
alt через лаунчер VoidRP
  L -> S : коннект, билет — метка в адресе подключения
  S -> B : verify ticket (X-Game-Auth-Secret)
  B --> S : ок → игрок сразу в мире
else обычный клиент
  S -> U : окно «Вход на VoidRP»\n(диалог Minecraft 1.21.6+, фаза конфигурации)
  U -> S : пароль от аккаунта сайта
  S -> B : /server/auth/game/* (пароль не хранится на сервере)
  B --> S : ок / регистрация / нужны согласия
end

== В игре ==
S -> B : синк статистики / экономики (по секрету сервера)
U -> S : открыть WebGUI
S -> U : webgui:open_web (url + webgui_token)
U -> B : /game-ui/* (webgui_token)
@enduml
